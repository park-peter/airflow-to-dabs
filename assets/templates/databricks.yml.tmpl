# yaml-language-server: $schema=bundle_config_schema.json
#
# Databricks Declarative Automation Bundles configuration
# Migrated from Airflow DAG: <DAG_ID>
# Migration date: <DATE>

bundle:
  name: <BUNDLE_NAME>

include:
  - resources/*.yml

# Declare each variable only when a generated task uses it, with no default, so
# `databricks bundle validate` reports the value the user must supply.
variables:
  # Only when a task runs on classic job compute.
  spark_version:
    description: Databricks Runtime for classic job compute
  node_type_id:
    description: Workspace-supported node type for classic job compute
  # Only when the bundle has a sql_task.
  warehouse_id:
    description: SQL warehouse ID for SQL tasks

targets:
  dev:
    mode: development
    workspace:
      host: <DEV_WORKSPACE_URL>
  prod:
    mode: production
    workspace:
      host: <PROD_WORKSPACE_URL>
    run_as:
      service_principal_name: <SERVICE_PRINCIPAL>
