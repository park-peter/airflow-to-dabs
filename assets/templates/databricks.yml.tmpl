# yaml-language-server: $schema=bundle_config_schema.json
#
# Databricks Asset Bundles configuration
# Migrated from Airflow DAG: <DAG_ID>
# Migration date: <DATE>

bundle:
  name: <BUNDLE_NAME>

include:
  - resources/*.yml

variables:
  spark_version:
    description: Spark runtime version (set per workspace policy/cloud)
    default: "<SPARK_VERSION>"
  node_type_id:
    description: Cluster node type (set per workspace policy/cloud)
    default: "<NODE_TYPE_ID>"
  warehouse_id:
    description: SQL warehouse ID for SQL tasks
    default: "<WAREHOUSE_ID>"

targets:
  dev:
    mode: development
    workspace:
      host: <DEV_WORKSPACE_URL>
  prod:
    mode: production
    workspace:
      host: <PROD_WORKSPACE_URL>
    run_as:
      service_principal_name: <SERVICE_PRINCIPAL>
