# Bundle target for validate/deploy AND the dbt profile target for parsing.
# Per-target manifest paths (target/$(TARGET)/) keep artifacts parsed against one
# profile target (e.g. dev catalog/schema) out of another target's deployment.
TARGET ?= dev

.PHONY: setup manifest validate deploy run test task-count

# Install the venv used by the PyDABs hook (databricks.yml -> python.venv_path).
# Uses your default package index; pass a private index if you need one, e.g.
#   make setup UV_INDEX_URL=<your-index-url>
setup:
	uv sync --dev

# Regenerate the dbt manifest read by the PyDABs hook in resources/.
# `dbt parse` does not connect to a warehouse; it only reads the project files.
# Static vars come from the committed dbt_vars.json — the same file the runner
# falls back to at run time, so parse-time and run-time always agree.
# For multiple dbt-bearing DAGs sharing the project, one parse covers all.
manifest:
	uv run dbt deps --profiles-dir dbt_profiles
	uv run dbt parse --profiles-dir dbt_profiles --target $(TARGET) --target-path target/$(TARGET) --vars "$$(cat dbt_vars.json)"
	test -f "target/$(TARGET)/manifest.json"

validate: manifest
	databricks bundle validate -t $(TARGET)

deploy: manifest
	databricks bundle deploy -t $(TARGET)

# <JOB_KEY> is the orchestrator (YAML) job key — running it triggers the
# generated dbt job through its run_job_task hop.
run:
	databricks bundle run <JOB_KEY> -t $(TARGET)

# Regression tests for the PyDABs glue (pure-logic tests need no dbt/warehouse;
# end-to-end tests skip unless `make manifest` produced target/<TARGET>/manifest.json).
test:
	uv run pytest tests

# Report how many tasks the generated dbt job would have, unbundled vs bundled,
# against the 1,000-task per-job limit. Run after `make manifest`. If the unbundled
# count is over WARN_THRESHOLD, set BUNDLE_TESTS = True in resources/<DAG_MODULE>_dbt_job.py.
task-count:
	@uv run python -c "from resources.<DAG_MODULE>_dbt_job import count_tasks, TASK_LIMIT, WARN_THRESHOLD; \
u = count_tasks('$(TARGET)', bundle_tests=False); b = count_tasks('$(TARGET)', bundle_tests=True); \
print(f'unbundled: {u} tasks  |  bundled: {b} tasks  |  warn>{WARN_THRESHOLD}  limit={TASK_LIMIT}')"
