# Job resource definition
# Migrated from Airflow DAG: <DAG_ID>

resources:
  jobs:
    <JOB_KEY>:
      name: <JOB_NAME>
      description: "Migrated from Airflow DAG: <DAG_ID>"
      tags:
        source: airflow-migration
        original_dag: <DAG_ID>
      max_concurrent_runs: 1

      # Required for file-arrival jobs so runs wait at the concurrency limit.
      # Delete this block only for a job with no file_arrival trigger.
      queue:
        enabled: true

      # Schedule -- replace with actual cron or trigger
      # schedule:
      #   quartz_cron_expression: "<QUARTZ_CRON>"
      #   timezone_id: "<TIMEZONE>"
      #   pause_status: UNPAUSED

      # OR Trigger -- uncomment if sensor-driven
      # trigger:
      #   file_arrival:
      #     url: "<EXTERNAL_LOCATION_URL>"
      #     min_time_between_triggers_seconds: 60
      #     wait_after_last_change_seconds: 60
      #   # table_update:
      #   #   condition: ANY_UPDATED
      #   #   table_names:
      #   #     - "main.silver.example_table"
      #   #   min_time_between_triggers_seconds: 300
      #   #   wait_after_last_change_seconds: 60
      #
      # OR Continuous mode -- for Airflow @continuous
      # continuous:
      #   pause_status: UNPAUSED

      # Job-level notifications
      # email_notifications:
      #   on_failure:
      #     - "<EMAIL>"

      # Job parameters (accessible by all tasks)
      # For an Airflow {{ ds }} that is a logical/partition date on a SCHEDULED job, default run_date
      # to {{job.trigger.time.iso_date}} (correct on normal runs); a native Databricks backfill
      # overrides it with {{backfill.iso_date}}. Use {{job.start_time.iso_date}} for wall-clock
      # "today" or an event-triggered job (trigger.time is unreliable there).
      # parameters:
      #   - name: run_date
      #     default: "{{job.trigger.time.iso_date}}"

      # Shared cluster definition
      job_clusters:
        - job_cluster_key: main-cluster
          new_cluster:
            spark_version: ${var.spark_version}
            node_type_id: ${var.node_type_id}
            num_workers: 2

      tasks:
        # --- Task: <TASK_KEY> ---
        # Airflow operator: <OPERATOR_TYPE>
        - task_key: <TASK_KEY>
          job_cluster_key: main-cluster
          # depends_on:
          #   - task_key: <UPSTREAM_TASK_KEY>
          notebook_task:
            notebook_path: ../src/<TASK_KEY>.py

        # --- dbt factory mode: trigger the Python-generated dbt job ---
        # Used where a dbt workload (e.g. cosmos DbtTaskGroup) sat in the DAG.
        # The job key matches JOB_KEY in resources/<DAG_MODULE>_dbt_job.py
        # (<DAG_MODULE> = dag_id sanitized to a Python identifier).
        # dbt_vars passes runtime vars through to the child job; define a
        # dbt_vars job parameter (default "{}") on this job too. Do not set
        # retries on this hop — a retry re-runs the entire dbt job.
        # - task_key: dbt_transform
        #   depends_on:
        #     - task_key: <UPSTREAM_TASK_KEY>
        #   run_job_task:
        #     job_id: ${resources.jobs.<DAG_MODULE>_dbt_job.id}
        #     job_parameters:
        #       dbt_vars: "{{job.parameters.dbt_vars}}"
