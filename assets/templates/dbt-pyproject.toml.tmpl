[project]
name = "<BUNDLE_NAME>"
version = "0.1.0"
requires-python = ">=3.10"
# Used at bundle validate/deploy time by the PyDABs hook in resources/.
dependencies = [
    "PyYAML>=6.0",
]

[dependency-groups]
dev = [
    # PyDABs runtime for the python.resources hook; pair with a compatible Databricks CLI.
    "databricks-bundles>=1.0.0,<2.0.0",
    # Generates one Databricks task per dbt node from the manifest.
    "databricks-dbt-factory==0.2.1",
    # Exact dbt pins give dbt version/runtime parity across machines and with the
    # serverless base environment (no lockfile is committed, so transitive deps are
    # not locked). dbt-core is pinned because the selector-exactness check imports it.
    "dbt-databricks==<DBT_DATABRICKS_VERSION>",
    "dbt-core==<DBT_CORE_VERSION>",
]
